# NOVA Cloud — example configuration
#
# Copy to .env and fill in. NEVER commit the filled-in file.
# Every value here is a placeholder; none of them work.
#
#   cp nova_cloud/.env.example .env
#
# Generate the two signing keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── environment ──────────────────────────────────────────────────────────────
# development | staging | production
# In production the app REFUSES to start without real signing keys, and every
# development affordance (returned tokens, console email) is disabled.
NOVA_ENV=development


# ── signing keys ─────────────────────────────────────────────────────────────
# Two DIFFERENT keys. The app refuses to start if they match, because a user
# token must never be able to validate as an admin token.
NOVA_SECRET_KEY=replace-me-with-48-random-bytes
NOVA_ADMIN_SECRET_KEY=replace-me-with-a-DIFFERENT-48-random-bytes


# ── database ─────────────────────────────────────────────────────────────────
# Leave unset for local SQLite development.
# Supabase: Project Settings → Database → Connection string → URI.
# Use the connection POOLER host (port 6543) for a web app; the direct host
# (5432) is for migrations and long-lived connections.
#
# DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=


# ── token lifetimes (seconds) ────────────────────────────────────────────────
# Access tokens are short because that window is how long a revoked device can
# still act. Refresh tokens rotate on every use.
NOVA_ACCESS_TTL=900
NOVA_REFRESH_TTL=5184000
NOVA_ADMIN_TTL=1800

# How long a device may keep working with no contact with the backend before
# it must sign in again. 30 days.
NOVA_OFFLINE_GRACE=2592000


# ── email ────────────────────────────────────────────────────────────────────
# resend | smtp | console | none
# "none" means verification and reset genuinely do not send. NOVA will say so
# rather than telling users to check an inbox.
EMAIL_PROVIDER=none

# Resend (https://resend.com) — verify your sending domain first.
RESEND_API_KEY=

# SMTP — any provider. Port 465 implies implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# Addresses. No domain is hard-coded anywhere in the codebase; these are the
# only place company addresses appear.
EMAIL_FROM=NOVA <hello@example.com>
SUPPORT_EMAIL=support@example.com
ADMIN_EMAIL=admin@example.com
NOVA_BRAND=NOVA

# Public base URL used to build verification and reset links. Must be the
# address a user's browser can actually reach.
APP_BASE_URL=https://nova.example.com

# Require email verification before an account is considered verified.
# Turn on only once EMAIL_PROVIDER is configured and tested, or new users will
# be unable to complete sign-up.
NOVA_REQUIRE_EMAIL_VERIFICATION=0


# ── admin ────────────────────────────────────────────────────────────────────
# Administrators must enrol in TOTP before they can sign in. Leave this on.
NOVA_ADMIN_REQUIRE_MFA=1

# Used ONLY by `python -m nova_cloud.manage create-admin` so the password
# never appears in a command line or shell history. Unset it afterwards; the
# running server never reads it.
NOVA_ADMIN_PASSWORD=


# ── retention (days, 0 = keep indefinitely) ──────────────────────────────────
NOVA_RET_TELEMETRY=90
NOVA_RET_ERRORS=90
NOVA_RET_AUDIT=730
NOVA_RET_AUTH=180


# ── server ───────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080


# ── desktop client ───────────────────────────────────────────────────────────
# Set this on the CLIENT (not the server) to point NOVA at your backend.
# Unset means NOVA runs fully local: no account, no sign-in screen, no
# telemetry. That is a supported mode, not a broken one.
# NOVA_CLOUD_URL=https://api.nova.example.com

# ── model access, updates, proxy (see docs/NOVA_OWNER_SETUP_GUIDE.md) ────────
# The one Gemini key; stays on the server. Empty = managed model unavailable.
NOVA_GEMINI_API_KEY=
# Reverse proxies in front of the app that append X-Forwarded-For (Caddy = 1).
NOVA_TRUSTED_PROXY_HOPS=0
# Public half of the release-signing key (tools/release.py keygen).
NOVA_UPDATE_PUBLIC_KEY=
# Daily per-account limits on the default plan.
NOVA_PLAN_FREE_LIVE=60
NOVA_PLAN_FREE_GENERATE=400
