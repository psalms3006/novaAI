# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Virtual Environments
.venv/
venv/
env/

# Environment Variables
.env
.env.*
# ...but the templates are documentation, not configuration. Both were
# swept up by the line above, so a clean checkout had neither the
# example env nor the test that checks it can pass.
!.env.template
!**/.env.example

# API keys / credentials (NEVER commit)
config/api_keys.json
api_keys.json
byok.bin
*.key
*.pem

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# Archive
archive/
archive/*.log

# Databases
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
.pytest_cache/
.mypy_cache/

# Build
build/
dist/
*.egg-info/

# =========================
# AI Models
# =========================
models/
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# =========================
# Embeddings / Indexes
# =========================
*.faiss
*.index
*.npy

# =========================
# Wikipedia / Knowledge
# =========================
*.zim

# =========================
# Audio
# =========================
*.wav
# ...except the speaker fixtures. Four two-second clips, 250 KB, and
# without them the only end-to-end check on the numpy Kaldi front end
# cannot run -- it would skip, and a skip reads as a pass.
!tests/fixtures/voices/*.wav
!tests/fixtures/voice/*.wav
*.mp3
*.flac

# Keep sample audio
!samples/
!samples/**

# =========================
# Runtime Output
# =========================
generated/
captures/
nova_memories/
heartbeat_*.json
memory.json
memory_meta.json
memory_texts.json
data/nova_audit.ndjson
data/trust_preferences.json
# The audit log is written to the repo root, not data/, despite the
# ignore rule above naming data/nova_audit.ndjson -- a real path
# mismatch, out of scope to chase down here, but both locations need to
# be ignored or every PyInstaller build reports a dirty tree over a
# runtime log, not a source change.
/nova_audit.ndjson
/workflows.json

# =========================
# Claude Code session state (this tool's own working directories, not
# NOVA source)
# =========================
.claude/
.claude-flow/

# =========================
# Temporary / Backup
# =========================
*.tmp
*.bak
*.bak.*
*.old

# =========================
# OS
# =========================
Thumbs.db
Desktop.ini
.DS_Store
# Build and distribution output
dist/
build/
dist_temp/

# Executables and installers
*.exe
*.msi

# Archives
*.zip
*.rar
*.7z

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# PyInstaller
*.spec
# NOVA Cloud local development data (database, dev keys, traffic scripts)
.devcloud/

# PyInstaller alternate build paths used when dist/ is locked by a running app
dist_build/
build_tmp/
dist_v2/
build_tmp2/

# Archived dead/duplicate modules (kept out of builds; see archive/README.md)
archive/

# Build output from versioned build attempts. Generated, never source.
build_v*/
dist_v*/
build_voice/

# PyInstaller's --distpath staging directory. Not covered by dist/ or dist_v*/,
# so `git add -A` would have staged 3,518 files and 525 MB of build output,
# 207 MB of it DLLs that no other rule here excludes.
dist_stage/

# =========================
# Runtime state written by a dev run
# =========================
# A dev run keeps NOVA's data in the working directory, which for this
# repository is the repository. These are one user's memories, goals and
# tasks -- not source, and not something a fresh clone should start life
# already believing.
living_memory.json
goals.json
nova_tasks.json
nova_tasks_aios.json
nova_cost.json
# Ad-hoc captures from vision testing.
screenshot_*.png

# NOVA UI (React, desk/ui): dependencies are installed, never committed.
# Its build output (desk/static/ui) IS committed, so a source checkout and the
# PyInstaller bundle run without Node.
desk/ui/node_modules/

# Browser-automation screenshots and snapshots from local UI testing.
.playwright-mcp/
desk/ui/tsconfig.tsbuildinfo
memory_texts.before-cleanup.*.json
