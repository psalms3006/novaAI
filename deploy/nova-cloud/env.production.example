# NOVA Cloud production settings. Copy to .env IN THIS FOLDER ON THE SERVER
# and fill in. Never commit the filled-in file; never paste it into chat.
# docs/NOVA_OWNER_SETUP_GUIDE.md says where each value comes from.

# Your API address, without https:// (e.g. api.yourdomain.com).
NOVA_DOMAIN=
APP_BASE_URL=https://api.yourdomain.com

# Two different random secrets. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NOVA_SECRET_KEY=
NOVA_ADMIN_SECRET_KEY=

# Supabase -> Project Settings -> Database -> Connection string -> URI,
# using the POOLER host (port 6543). Put your database password in it.
DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The one Gemini key NOVA uses on behalf of every account. Stays on this server.
NOVA_GEMINI_API_KEY=

# Email (Resend). Verify your sending domain in Resend first.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=NOVA <hello@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com
ADMIN_EMAIL=you@yourdomain.com
NOVA_REQUIRE_EMAIL_VERIFICATION=1

# Google sign-in ("Continue with Google" on the desktop).
# Create an OAuth client of type **Web application** in Google Cloud Console
# and add this exact authorised redirect URI to it:
#   <APP_BASE_URL>/v1/auth/google/callback
# Without all three values, /v1/auth/google/start answers 503
# oauth_not_configured and the desktop says Google sign-in is not available.
NOVA_GOOGLE_OAUTH_CLIENT_ID=
NOVA_GOOGLE_OAUTH_CLIENT_SECRET=
NOVA_GOOGLE_OAUTH_REDIRECT_URI=

# Public half of your release-signing key (tools/release.py keygen prints it).
NOVA_UPDATE_PUBLIC_KEY=

# Daily limits per account on the default plan.
NOVA_PLAN_FREE_LIVE=60
NOVA_PLAN_FREE_GENERATE=400

# Admin console: TOTP is required. Leave on.
NOVA_ADMIN_REQUIRE_MFA=1
